{
  "$schema": "../profile.schema.json",
  "profile_format_version": 1,
  "profile_id": "noark5",
  "display_name": "Noark 5",
  "status": "active_development_a26",
  "profile_root": "config/noark5",
  "supported_versions": ["3.1", "4.0", "5.0"],
  "principles": {
    "manifest_is_authoritative_entrypoint": true,
    "profile_specific_knowledge_outside_generic_engine": true,
    "source_provenance_required": true,
    "observations_separate_from_assessment": true,
    "generic_observed_values_preserved": true,
    "version_specific_rules_must_be_explicit": true,
    "do_not_assume_rules_across_versions": true
  },
  "sources": {"registry": "config/noark5/standards/sources.json"},
  "capabilities": {
    "schema_validation": true,
    "xpath_analysis": true,
    "whole_extraction_scope": true,
    "archive_part_scope": true,
    "reconciliation": true,
    "standard_value_comparison": true,
    "legacy_regression_reference": true,
    "execution_profiles": true,
    "explicit_regression_operation": true,
    "canonical_views": true,
    "result_composition": true,
    "views_compositions": true,
    "reusable_view_sections": true,
    "audience_specific_views": true,
    "materialized_presentation_profiles": true,
    "depot_validation_report": true,
    "arkade5_external_evidence_import": true,
    "arkade5_lossless_normalization": true,
    "arkade5_verified_semantic_mapping": true
  },
  "definitions": {
    "tests": ["config/noark5/tests/xpath_catalog_2026_05_26.json"],
    "external_tests": ["config/noark5/external/arkade5_test_catalog.json"],
    "analysis": [
      "config/noark5/analysis/u1_total.json",
      "config/noark5/analysis/u1_u2_core_arkiv_arkivdel.json",
      "config/noark5/analysis/u1_u2_coverage_2026_05_26.json",
      "config/noark5/analysis/legacy_regression_contract.json"
    ],
    "standards": [
      "config/noark5/standards/noark5_standard_values.json",
      "config/noark5/standards/specification_coverage.json",
      "config/noark5/standards/provenance_contract.json"
    ],
    "schemas": ["config/noark5/xml_schema_validation.json"],
    "views": ["config/noark5/views/canonical_views.json"],
    "field_definitions": ["config/noark5/arkivstruktur_fields.json"],
    "metadata": ["config/noark5/standards/metadata/index.json"],
    "requirements": ["config/noark5/standards/requirements/index.json"],
    "reports": ["config/noark5/reports/depot_validation_report.json"],
    "external_mappings": ["config/noark5/external/dwm_arkade5_mapping.json"]
  },
  "documentation": [
    "docs/NOARK5-PROFILE-ARCHITECTURE.md",
    "docs/NOARK5-ANALYSIS-MODEL.md",
    "docs/NOARK5-STANDARD-VALUES.md",
    "docs/NOARK5-TERMINOLOGY-NOTE.md",
    "docs/NOARK5-U1-U2-COVERAGE-MAPPING.md",
    "docs/ARKADE5-NOARK5-TESTS.md",
    "docs/ARKADE5-DWM-MAPPING.md",
    "docs/ARKADE5-IMPORT-MODEL.md"
  ],
  "legacy_reference": {
    "repository": "IKAMR/KDRS_Query",
    "master_definition": "doc/xml-queries_noark5_2026-05-26.txt",
    "terminology_note": "U1/U2 are local historical names, retained only for traceability/regression.",
    "normal_execution": false,
    "regression_execution_profile": "regression",
    "regression_operation_id": "run_noark5_xpath_regression_2026"
  },
  "future": {
    "view_model": "config/noark5/views/",
    "external_creator_control": "separate comparison layer; not XPath test logic",
    "report_generation": "a26 consumes canonical views/compositions; reports must not recalculate source data"
  },
  "specification_knowledge": {
    "coverage": "config/noark5/standards/specification_coverage.json",
    "provenance_contract": "config/noark5/standards/provenance_contract.json",
    "rule": "Official Noark knowledge is reusable only when discoverable from this manifest and traceable to the registered source.",
    "maturity": {
      "architecture": "established",
      "standard_values": "partial_verified",
      "metadata": "partial_verified",
      "requirements": "partial_verified_v5_started",
      "full_specification_coverage": false
    }
  },
  "presentation": {
    "profiles": "config/noark5/views/presentation_profiles.json",
    "rule": "Presentation profiles consume composed views and do not change canonical calculations."
  },
  "presentation_profiles": "config/noark5/views/presentation_profiles.json"
}
