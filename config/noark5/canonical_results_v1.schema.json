{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IKAMR/data-workflow-manager/config/noark5/canonical_results_v1.schema.json",
  "title": "Noark 5 canonical result snapshot, first local contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "profile_id", "generated_at", "extraction", "sources", "observations", "assessments", "summary", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_id": {"const": "noark5.canonical-results.v1"},
    "profile_id": {"const": "noark5"},
    "generated_at": {"type": "string"},
    "extraction": {
      "type": "object",
      "required": ["stable_id", "id_type", "job_id_at_generation", "identity_scope"],
      "properties": {
        "stable_id": {"type": "string", "format": "uuid"},
        "id_type": {"const": "dwm_work_job_uid"},
        "job_id_at_generation": {"type": "string"},
        "identity_scope": {"const": "work_job_not_verified_source_hash"},
        "delivery_id": {"type": ["string", "null"]},
        "noark_version": {"type": ["string", "null"]},
        "system": {"type": ["string", "null"]},
        "archive_creators": {"type": ["array", "null"]},
        "archive_owner": {"type": ["string", "null"]}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_kind", "reference"],
        "properties": {
          "source_kind": {"enum": ["dwm_master", "dwm_raw", "external_result_bank"]},
          "reference": {"$ref": "#/$defs/fileRef"}
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_id", "source_kind", "test_id", "status", "availability", "authoritative_internal_master", "numeric_values", "metrics_aggregatable", "evidence"],
        "properties": {
          "observation_id": {"type": "string", "format": "uuid"},
          "source_kind": {"enum": ["dwm_master", "dwm_raw", "arkade5", "kdrs_query", "external_other"]},
          "test_id": {"type": ["string", "null"]},
          "run_reference": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "availability": {"enum": ["available", "unavailable", "unknown"]},
          "authoritative_internal_master": {"type": "boolean"},
          "metadata_id": {"type": ["string", "null"]},
          "rule_version": {"type": ["string", "null"]},
          "value_type": {"type": "string"},
          "numeric_values": {"type": "object", "additionalProperties": {"type": "number"}},
          "metrics_aggregatable": {"const": false},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["work_relative_path"], "properties": {"work_relative_path": {"type": "string"}, "sha256": {"type": "string"}, "result_id": {"type": "string"}, "resource_id": {"type": "string"}}}},
          "source_xml": {"type": ["string", "null"]},
          "xpath": {"type": ["string", "null"]},
          "system_id": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]}
        }
      }
    },
    "assessments": {"type": "array", "maxItems": 0},
    "summary": {
      "type": "object",
      "required": ["observations", "available_internal_master", "external_observations", "not_aggregated"],
      "properties": {
        "observations": {"type": "integer", "minimum": 0},
        "available_internal_master": {"type": "integer", "minimum": 0},
        "external_observations": {"type": "integer", "minimum": 0},
        "not_aggregated": {"const": true}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fileRef": {
      "type": "object", "required": ["work_relative_path", "sha256"],
      "properties": {
        "work_relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
